rivate_capture(jsonb)'),\n  ('public.jenios_robot_r67_read_private_captures(jsonb)'),\n  ('public.jenios_robot_r71_digest(jsonb)'),\n  ('public.jenios_robot_r71_fields(jsonb,text[])'),\n  ('public.jenios_robot_r71_integer(jsonb,bigint,bigint)'),\n  ('public.jenios_robot_r71_version(jsonb)'),\n  ('public.jenios_robot_r71_scope(jsonb)'),\n  ('public.jenios_robot_r71_now(jsonb)'),\n  ('public.jenios_robot_r71_ingest_private_observation(jsonb)'),\n  ('public.jenios_robot_r71_freeze_study(jsonb)'),\n  ('public.jenios_robot_r71_read_study_page(jsonb)'),\n  ('public.jenios_robot_r71_read_state(jsonb)'),\n  ('public.jenios_robot_r71_read_validation_cases(jsonb)'),\n  ('public.jenios_robot_r71_read_overview(jsonb)'),\n  ('public.jenios_robot_r71_plan(jsonb)'),\n  ('public.jenios_robot_r71_append_state(jsonb)')\n), relations AS (\n  SELECT e.name,c.oid,c.relkind,c.relrowsecurity\n  FROM expected_relations e LEFT JOIN pg_catalog.pg_class c\n    ON c.oid=pg_catalog.to_regclass('public.'||e.name)\n), functions AS (\n  SELECT e.signature,p.oid,p.prosecdef\n  FROM expected_functions e LEFT JOIN pg_catalog.pg_proc p\n    ON p.oid=pg_catalog.to_regprocedure(e.signature)\n)\nSELECT jsonb_build_object(\n  'observedAtUtc',to_char(clock_timestamp() AT TIME ZONE 'UTC','YYYY-MM-DD HH24:MI:SS')||' UTC',\n  'serverVersion',current_setting('server_version'),\n  'robotRelationsExpected',(SELECT count(*) FROM relations),\n  'robotRelationsPresent',(SELECT count(*) FROM relations WHERE oid IS NOT NULL),\n  'missingRobotRelations',(SELECT coalesce(jsonb_agg(name ORDER BY name),'[]'::jsonb) FROM relations WHERE oid IS NULL),\n  'unexpectedRelationKinds',(SELECT coalesce(jsonb_agg(name ORDER BY name),'[]'::jsonb) FROM relations WHERE oid IS NOT NULL AND relkind NOT IN('r','p')),\n  'relationsWithoutRls',(SELECT coalesce(jsonb_agg(name ORDER BY name),'[]'::jsonb) FROM relations WHERE oid IS NOT NULL AND NOT relrowsecurity),\n  'robotFunctionsExpected',(SELECT count(*) FROM functions),\n  'robotFunctionsPresent',(SELECT count(*) FROM functions WHERE oid IS NOT NULL),\n  'missingRobotFunctions',(SELECT coalesce(jsonb_agg(signature ORDER BY signature),'[]'::jsonb) FROM functions WHERE oid IS NULL),\n  'securityDefinerFunctions',(SELECT coalesce(jsonb_agg(signature ORDER BY signature),'[]'::jsonb) FROM functions WHERE oid IS NOT NULL AND prosecdef),\n  'requiredRoles',(SELECT coalesce(jsonb_agg(jsonb_build_object('name',rolname,'bypassRls',rolbypassrls) ORDER BY rolname),'[]'::jsonb)\n    FROM pg_catalog.pg_roles WHERE rolname IN('anon','authenticated','service_role')),\n  'platformAdminPermissionTable',(SELECT jsonb_build_object('present',c.oid IS NOT NULL,'rls',c.relrowsecurity,\n    'anonSelect',CASE WHEN c.oid IS NOT NULL THEN has_table_privilege('anon',c.oid,'SELECT') ELSE NULL END,\n    'authenticatedSelect',CASE WHEN c.oid IS NOT NULL THEN has_table_privilege('authenticated',c.oid,'SELECT') ELSE NULL END,\n    'serviceRoleSelect',CASE WHEN c.oid IS NOT NULL THEN has_table_privilege('service_role',c.oid,'SELECT') ELSE NULL END)\n    FROM (SELECT pg_catalog.to_regclass('public.jenios_platform_admin_permissions') AS oid) x\n    LEFT JOIN pg_catalog.pg_class c ON c.oid=x.oid)\n) AS catalog_inventory;\n",
